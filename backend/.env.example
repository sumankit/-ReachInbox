# --- Server ---
PORT=4000
NODE_ENV=development

# --- Postgres (Prisma) ---
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public"

# --- Redis (BullMQ + rate-limit counters) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Must be the SAME value as NEXTAUTH_SECRET in frontend/.env.local
# Frontend signs a JWT with this secret after Google login; backend verifies it.
JWT_SHARED_SECRET="replace-with-a-long-random-string"

# --- Worker tuning ---
# How many jobs the BullMQ worker processes in parallel
WORKER_CONCURRENCY=5
# Minimum milliseconds between ANY two email sends (global throttle, mimics provider throttling)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Default per-sender emails/hour cap, used when a campaign doesn't override it
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Ethereal senders are stored in DB (see seed:senders script), no env creds needed here ---
