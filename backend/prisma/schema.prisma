generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id        String     @id @default(uuid())
  googleId  String     @unique
  email     String     @unique
  name      String?
  avatarUrl String?
  createdAt DateTime   @default(now())
  campaigns Campaign[]
}

/// A fake SMTP identity (Ethereal test account) emails can be sent from.
model Sender {
  id        String      @id @default(uuid())
  name      String
  email     String      @unique
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  createdAt DateTime    @default(now())
  emailJobs EmailJob[]
}

/// One "Schedule new email" submission from the dashboard: a subject/body
/// sent to many recipients, spaced out by delay/hourlyLimit.
model Campaign {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  subject         String
  body            String     @db.Text
  startTime       DateTime
  delayMs         Int
  hourlyLimit     Int
  createdAt       DateTime   @default(now())
  emailJobs       EmailJob[]
}

/// One individual email send, one row per recipient. This is the unit
/// scheduled into BullMQ (jobId = EmailJob.id, guaranteeing idempotency).
model EmailJob {
  id            String      @id @default(uuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id])
  senderId      String
  sender        Sender      @relation(fields: [senderId], references: [id])
  recipient     String
  subject       String
  body          String      @db.Text
  scheduledAt   DateTime
  status        EmailStatus @default(SCHEDULED)
  bullJobId     String?
  attempts      Int         @default(0)
  error         String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([campaignId])
}
